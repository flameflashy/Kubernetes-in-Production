{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["policies"],
  "properties": {
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readonlyRootFilesystem", "personLabel", "istioSidecar"],
      "properties": {
        "readonlyRootFilesystem": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "failureAction", "background", "emitWarning", "namespaces"],
          "properties": {
            "enabled": { "type": "boolean" },
            "failureAction": { "type": "string", "enum": ["Audit", "Enforce"] },
            "background": { "type": "boolean" },
            "emitWarning": { "type": "boolean" },
            "namespaces": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "personLabel": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "background", "emitWarning", "labelKey", "studentValue", "mentorValue", "studentNamespaces", "mentorNamespace"],
          "properties": {
            "enabled": { "type": "boolean" },
            "background": { "type": "boolean" },
            "emitWarning": { "type": "boolean" },
            "labelKey": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
            "studentValue": { "type": "string", "minLength": 1 },
            "mentorValue": { "type": "string", "minLength": 1 },
            "studentNamespaces": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "mentorNamespace": { "type": "string", "minLength": 1 }
          }
        },
        "istioSidecar": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "injectionLabel", "injectionValue"],
          "properties": {
            "enabled": { "type": "boolean" },
            "injectionLabel": {
              "type": "string",
              "const": "sidecar.istio.io/inject"
            },
            "injectionValue": {
              "type": "string",
              "const": "true"
            }
          }
        }
      }
    }
  }
}
